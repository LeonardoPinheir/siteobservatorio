{
  "entities": {
    "Book": {
      "title": "Book",
      "description": "Publicação acadêmica, livro autoral, coletânea ou e-book",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 500, "description": "Título principal da obra" },
        "subtitle": { "type": "string", "maxLength": 500, "description": "Subtítulo da obra" },
        "type": { "type": "string", "enum": ["Livro autoral", "Coletânea / Organizado", "E-book", "Relatório de Pesquisa", "Dossiê Temático"] },
        "edition": { "type": "string", "maxLength": 50 },
        "publicationDate": { "type": "string" },
        "year": { "type": "number" },
        "volume": { "type": "string", "maxLength": 50 },
        "collection": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 200 },
        "language": { "type": "string", "maxLength": 50 },
        "publisher": { "type": "string", "maxLength": 200 },
        "publicationCity": { "type": "string", "maxLength": 200 },
        "authors": { "type": "string", "maxLength": 1000 },
        "organizers": { "type": "string", "maxLength": 1000 },
        "isbn": { "type": "string", "maxLength": 50 },
        "isbnDigital": { "type": "string", "maxLength": 50 },
        "doi": { "type": "string", "maxLength": 200 },
        "doiUrl": { "type": "string", "maxLength": 500 },
        "zenodoUrl": { "type": "string", "maxLength": 500 },
        "pages": { "type": "string", "maxLength": 50 },
        "abstract": { "type": "string", "maxLength": 10000 },
        "synopsis": { "type": "string", "maxLength": 5000 },
        "license": { "type": "string", "maxLength": 200 },
        "coverUrl": { "type": "string", "maxLength": 1000 },
        "pdfUrl": { "type": "string", "maxLength": 1000 },
        "downloadLink": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["Rascunho", "Agendado", "Publicado"] },
        "isFeatured": { "type": "boolean" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["title", "status", "year"]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "Capítulo individual vinculado a uma obra",
      "type": "object",
      "properties": {
        "bookId": { "type": "string" },
        "chapterNumber": { "type": "string" },
        "order": { "type": "number" },
        "title": { "type": "string", "maxLength": 500 },
        "authors": { "type": "string", "maxLength": 1000 },
        "abstract": { "type": "string", "maxLength": 5000 },
        "startPage": { "type": "string" },
        "endPage": { "type": "string" },
        "doi": { "type": "string", "maxLength": 200 },
        "pdfUrl": { "type": "string", "maxLength": 1000 },
        "externalLink": { "type": "string", "maxLength": 1000 }
      },
      "required": ["bookId", "title", "authors"]
    },
    "Author": {
      "title": "Author",
      "description": "Diretório de autores, pesquisadores e organizadores",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "defaultRole": { "type": "string" },
        "orcid": { "type": "string", "maxLength": 100 },
        "institution": { "type": "string", "maxLength": 250 },
        "country": { "type": "string", "maxLength": 100 },
        "bio": { "type": "string", "maxLength": 2000 }
      },
      "required": ["name"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Submissão de proposta de livro por autores",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 500 },
        "abstract": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["Recebida", "Em análise", "Ajustes solicitados", "Aprovada", "Rejeitada"] },
        "date": { "type": "string" }
      },
      "required": ["name", "email", "title"]
    }
  },
  "firestore": {
    "/books/{bookId}": {
      "schema": "Book",
      "description": "Obras publicadas ou em edição da editora"
    },
    "/chapters/{chapterId}": {
      "schema": "Chapter",
      "description": "Capítulos de livros com downloads e metadados individuais"
    },
    "/authors/{authorId}": {
      "schema": "Author",
      "description": "Cadastro de autores e organizadores"
    },
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Propostas de publicação submetidas por pesquisadores"
    }
  }
}
