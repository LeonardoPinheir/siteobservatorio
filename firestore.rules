rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && (
        request.auth.token.email.matches('(?i)^leonardo\\.pinheirolk@gmail\\.com$') ||
        request.auth.token.email.matches('(?i)^leonardo\\.pinheiro@uft\\.edu\\.br$')
      );
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isSignedIn() && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )
      );
    }

    // Admins and editors collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Books collection - Public read for published books; Admin can do all
    match /books/{bookId} {
      allow get, list: if resource.data.status == 'Publicado' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Chapters collection - Public read for readers; Admin can manage
    match /chapters/{chapterId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Authors directory
    match /authors/{authorId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Editorial Collections
    match /collections/{collectionId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Open Calls for papers / book chapters
    match /open_calls/{callId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Team members
    match /team_members/{memberId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Submission templates
    match /submission_templates/{templateId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Submissions: Public creation; Strictly private reading for admins
    match /submissions/{submissionId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.email is string
                    && request.resource.data.title is string;
      allow read, update, delete: if isAdmin();
    }

    // Messages: Public creation via contact form; Strictly private reading for admins
    match /messages/{messageId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.content is string;
      allow read, update, delete: if isAdmin();
    }
  }
}
